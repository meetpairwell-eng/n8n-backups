      "name": "Plan Columns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const vals = $input.first().json.values || [[]];\nconst headers = (vals[0] || []).map(h => String(h || '').trim());\nconst want = ['Price Range', 'Timeline', 'Financing'];\nconst missing = want.filter(w => !headers.some(h => h.toLowerCase() === w.toLowerCase()));\nif (!missing.length) return [];\nlet n = headers.length;\nwhile (n > 0 && !headers[n-1]) n--;\nconst col = i => { let s = '', x = i; while (x >= 0) { s = String.fromCharCode(65 + (x % 26)) + s; x = Math.floor(x / 26) - 1; } return s; };\nconst start = col(n), end = col(n + missing.length - 1);\nreturn [{ json: { range: start + '1:' + end + '1', headers: missing, existing: n,\n  bodyJson: JSON.stringify({ values: [missing] }) } }];"
      }
    },
