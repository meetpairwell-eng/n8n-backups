    },
    {
      "parameters": {
        "jsCode": "const sh = ($json.sheets||[]).find(s => s.properties && s.properties.title === 'Leads');\nif (!sh) throw new Error('Leads tab not found');\nconst gid = sh.properties.sheetId;\nconst rows = ((sh.data||[])[0]||{}).rowData || [];\nconst hits = [];\nrows.forEach(function(r, i){\n  const vals = r.values || [];\n  const firstName = (vals[1] && vals[1].formattedValue) || '';\n  if (i > 0 && String(firstName).indexOf('ZZTEST') === 0) hits.push({row: i, name: firstName});\n});\nif (hits.length === 0) throw new Error('no ZZTEST rows found');\nif (hits.length > 5) throw new Error('refusing: ' + hits.length + ' matches, expected <= 5');\nconst requests = hits.slice().sort(function(a,b){ return b.row - a.row; }).map(function(h){\n  return { deleteDimension: { range: { sheetId: gid, dimension: 'ROWS', startIndex: h.row, endIndex: h.row + 1 } } };\n});\nreturn [{ json: { found: hits, payload: JSON.stringify({ requests: requests }) } }];"
      },
