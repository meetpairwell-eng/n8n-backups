      "position": [
        0,
        0
      ],
      "webhookId": "ig-link-click"
    },
    {
      "parameters": {
        "jsCode": "const inp = $input.first().json;\nconst q = inp.query || {};\nconst headers = inp.headers || {};\nconst ua = String(headers['user-agent'] || '');\n\n// Rebuild the destination from a STRICTLY validated id. Never redirect to a\n// caller-supplied URL - that would turn this into an open redirect that anyone\n// could use to launder a phishing link through Hector's domain.\nconst shareId = String(q.i || '').trim();\nconst valid = /^[A-Za-z0-9]{4,64}$/.test(shareId);\nconst dest = valid\n  ? 'https://portal.onehome.com/en-US/share/' + shareId\n  : 'https://hectormeza.com/';\n\n// Preview CRAWLERS only - deliberately NOT 'Instagram' or 'FBAV'. Instagram's\n// link-preview fetch identifies as facebookexternalhit, while a real human\n// tapping from inside the IG app sends a UA CONTAINING 'Instagram'. Filtering\n// on 'Instagram' would silently discard every genuine click.\nconst BOTS = /(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Slack-ImgProxy|TelegramBot|Discordbot|WhatsApp\\/|SkypeUriPreview|Embedly|Iframely|redditbot|Pinterest|Applebot|Googlebot|bingbot|DuckDuckBot|YandexBot|Baiduspider|curl\\/|Wget|python-requests|python-urllib|node-fetch|axios\\/|Go-http-client|okhttp|libwww-perl|Java\\/|HeadlessChrome|PhantomJS|crawler|spider|scraper|monitoring|uptime|pingdom|statuscake|preview)/i;\nconst isBot = BOTS.test(ua) || ua === '';\n\nconst ts = new Intl.DateTimeFormat('en-CA', {\n  timeZone: 'America/Chicago', year: 'numeric', month: '2-digit', day: '2-digit',\n  hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false\n}).format(new Date()).replace(',', '');\n\nlet device = /iPhone|iPad|Android|Mobile/i.test(ua) ? 'Mobile' : 'Desktop';\nif (/Instagram/i.test(ua)) device += ' (IG app)';\n\nreturn [{ json: {\n  ts: ts,\n  dest: dest,\n  isBot: isBot,\n  shareId: shareId,\n  handle: String(q.r || '').trim(),\n  device: device,\n  ua: ua.slice(0, 300)\n} }];"
      },
      "id": "w2",
      "name": "Classify",
      "type": "n8n-nodes-base.code",
