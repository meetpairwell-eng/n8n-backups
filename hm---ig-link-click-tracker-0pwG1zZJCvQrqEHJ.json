    {
      "parameters": {
        "jsCode": "// Decides whether this click is worth a text.\n// Throttle: one text per handle per 30 minutes. A reload or a second tap should\n// not buzz the phone twice, and the point of the alert is \"they are looking RIGHT\n// NOW\" - which the first text already said.\nconst c = $('Classify').first().json;\n\n// shareId -> street address, so the text names the house instead of an id.\nlet addr = '';\ntry {\n  const rows = ($('Read Settings').first().json.values) || [];\n  for (const r of rows) {\n    const link = String((r && r[4]) || '');\n    if (c.shareId && link.indexOf(c.shareId) >= 0) { addr = String(r[0] || '').trim(); break; }\n  }\n} catch (e) { /* address is a nicety, never block the alert on it */ }\n\n// Timestamps are written 'YYYY-MM-DD HH:MM:SS' in one timezone, so a plain\n// string compare is also a chronological compare. No date parsing needed.\nconst cutoff = new Intl.DateTimeFormat('en-CA', {\n  timeZone: 'America/Chicago', year: 'numeric', month: '2-digit', day: '2-digit',\n  hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false\n}).format(new Date(Date.now() - 30 * 60 * 1000)).replace(',', '');\n\nlet recent = 0;\ntry {\n  const rows = ($('Read Clicks').first().json.values) || [];\n  for (const r of rows) {\n    const t = String((r && r[0]) || '');\n    const h = String((r && r[1]) || '').trim();\n    if (h && c.handle && h.toLowerCase() === c.handle.toLowerCase() && t >= cutoff) recent++;\n  }\n} catch (e) { recent = 1; }\n\n// The row for THIS click is already in the sheet, so 1 means it is the first.\nconst notify = recent <= 1;\nreturn [{ json: {\n  notify: notify,\n  handle: c.handle || '(no handle)',\n  addr: addr,\n  device: c.device,\n  net: c.net,\n  recent: recent\n} }];"
      },
