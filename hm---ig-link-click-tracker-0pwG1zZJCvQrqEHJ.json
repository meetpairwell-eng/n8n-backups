    {
      "parameters": {
        "jsCode": "// The Cloudflare Worker already filtered crawlers, stale browsers and\n// datacentre traffic before calling this. What is left here is a second line of\n// defence plus the fields the sheet records.\nconst inp = $input.first().json;\nconst q = inp.query || {};\nconst headers = inp.headers || {};\nconst ua = String(headers['user-agent'] || '');\n\nconst shareId = String(q.i || '').trim();\nconst valid = /^[A-Za-z0-9]{4,64}$/.test(shareId);\n\nconst BOTS = /(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|WhatsApp\\/|Embedly|redditbot|Applebot|Googlebot|bingbot|curl\\/|Wget|python-requests|node-fetch|axios\\/|Go-http-client|okhttp|HeadlessChrome|crawler|spider|scraper|preview)/i;\nlet isBot = BOTS.test(ua) || ua === '' || !valid;\nlet m = ua.match(/Firefox\\/(\\d+)/i); if (m && +m[1] < 100) isBot = true;\nm = ua.match(/Chrome\\/(\\d+)/i);      if (m && +m[1] < 100) isBot = true;\n\nconst ts = new Intl.DateTimeFormat('en-CA', {\n  timeZone: 'America/Chicago', year: 'numeric', month: '2-digit', day: '2-digit',\n  hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false\n}).format(new Date()).replace(',', '');\n\nlet device = /iPhone|iPad|Android|Mobile/i.test(ua) ? 'Mobile' : 'Desktop';\nif (/Instagram/i.test(ua)) device += ' (IG app)';\n\nreturn [{ json: {\n  ts: ts,\n  dest: valid ? 'https://portal.onehome.com/en-US/share/' + shareId : 'https://hectormeza.com/',\n  isBot: isBot,\n  shareId: shareId,\n  handle: String(q.r || '').trim(),\n  net: String(q.net || '').trim(),\n  cc: String(q.cc || '').trim(),\n  device: device,\n  ua: ua.slice(0, 300)\n} }];"
      },
