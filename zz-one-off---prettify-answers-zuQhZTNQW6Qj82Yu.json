      "parameters": {
        "jsCode": "const rows = ($json.values) || [];\nfunction pretty(val) {\n  let s = String(val == null ? '' : val).trim();\n  if (!s) return '';\n  if (s.indexOf('<test lead') === 0) return s;\n  s = s.replace(/_/g, ' ').replace(/\\s+/g, ' ').trim();\n  s = s.replace(/\\$(\\d+(?:\\.\\d+)?)\\s*([km])\\b/gi, function(m,n,u){ return '$' + n + u.toUpperCase(); });\n  return s.charAt(0).toUpperCase() + s.slice(1);\n}\nconst out = rows.map(function(r){ return [pretty(r[0]), pretty(r[1]), pretty(r[2])]; });\nif (!out.length) throw new Error('nothing to backfill');\nconst range = 'Leads!H2:J' + (out.length + 1);\nreturn [{ json: { range: range, count: out.length, before: rows, after: out, payload: JSON.stringify({ values: out }) } }];"
      },
