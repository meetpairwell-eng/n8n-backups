    {
      "parameters": {
        "jsCode": "\nconst row = ($input.first().json.values || [[]])[0] || [];\nconst headers = row.map(x => String(x||'').trim());\nconst want = ['Day 5 Email Sent','Last Touch'];\nconst missing = want.filter(w => !headers.some(x => x.toLowerCase() === w.toLowerCase()));\nif (!missing.length) return [{ json: { skip:true, note:'both columns already exist', headers } }];\nconst col = n => { let s=''; n=n+1; while(n>0){ const m=(n-1)%26; s=String.fromCharCode(65+m)+s; n=Math.floor((n-1)/26);} return s; };\nconst start = headers.length;                    // first empty column index\nconst range = 'Leads!' + col(start) + '1:' + col(start + missing.length - 1) + '1';\nreturn [{ json: { skip:false, range, values:[missing], existingCount: headers.length,\n                  lastExisting: headers[headers.length-1], adding: missing } }];\n"
      },
      "id": "c2",
      "name": "Find Empty Columns",
      "type": "n8n-nodes-base.code",
