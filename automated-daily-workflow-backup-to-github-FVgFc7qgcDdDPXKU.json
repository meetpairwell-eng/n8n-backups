    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Strip Twilio Account SID from the backed-up copy so GitHub secret-scanning\n// does not block the push. Live workflows are untouched (this only edits the\n// JSON that gets committed). Add more patterns here if other secrets appear.\nreturn $input.all().map((item, i) => {\n  const scrubbed = JSON.parse(\n    JSON.stringify(item.json).replace(/AC[0-9a-fA-F]{32}/g, 'TWILIO_ACCOUNT_SID_REDACTED')\n  );\n  return { json: scrubbed, pairedItem: { item: i } };\n});"
      },
