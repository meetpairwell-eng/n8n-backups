    {
      "parameters": {
        "jsCode": "\nconst lead = $('Check For Duplicate').first().json;\n\n// E.164 the phone; anything that isn't a clean 10-digit US number is skipped\nconst d = String(lead.phone || '').replace(/\\D/g, '').replace(/^1(?=\\d{10}$)/, '');\nconst to = d.length === 10 ? '+1' + d : '';\n\n// TCPA: no marketing texts outside 8am-9pm local. Central is Hector's market.\nconst hour = DateTime.now().setZone('America/Chicago').hour;\nconst quiet = hour < 8 || hour >= 21;\n\nconst first = (lead.first || '').trim() || 'there';\nconst addr  = String(lead.searchedAddress || '').split(',')[0].trim();\n\nconst body = addr\n  ? `Hey ${first}, it's Hector. Thanks for reaching out about ${addr}. Before I put a number together I'd like to hear a little about the home from you, so I'll give you a call in a bit. If another time is easier, just text me back and let me know.\\n\\nReply STOP to unsubscribe.`\n  : `Hey ${first}, it's Hector. Thanks for reaching out. I'll give you a call in a bit to hear more about what you're looking for and how I can help.\\n\\nReply STOP to unsubscribe.`;\n\nconst send = Boolean(to) && !quiet;\n\nreturn [{ json: {\n  to, body, send,\n  skipReason: !to ? 'no valid US mobile' : (quiet ? 'quiet hours (8am-9pm CT rule)' : ''),\n  email: lead.email,\n} }];\n"
      },
