    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst checked = $('Check MailerLite').all();\nconst dry = $('Pick Candidates').first()?.json?.dryRun ?? true;\nreturn [{ json: {\n  mode: dry ? 'DRY RUN (nothing written)' : 'LIVE',\n  candidates: checked.length,\n  alreadyInMailerLite: checked.filter(i => i.json.statusCode === 200).length,\n  newlyAdded: checked.filter(i => i.json.statusCode === 404).length,\n  writeFailures: $('Upsert To MailerLite').all()\n      .filter(i => ![200, 201].includes(i.json.statusCode)).length,\n} }];\n"
      },
