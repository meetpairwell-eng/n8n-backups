        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const DRY_RUN = false;\n\nconst src = [\n  ...$('Read Master Tab').all().map(i => ({ tab: 'Updated', r: i.json })),\n  ...$('Read Leads Tab').all().map(i => ({ tab: 'Leads',   r: i.json })),\n];\nconst clean = v => String(v ?? '').trim();\nconst out = [];\nfor (const { tab, r } of src) {\n  const email = clean(r['Email']).toLowerCase();\n  if (!email || !email.includes('@')) continue;\n  if (clean(r['On Mailer List']).toUpperCase() !== 'Y') continue;   // Hector's gate\n  const NO_MAIL = /^(unsubscribed|bounced|spam complaint|do not contact|no contact)$/i;\n  if (NO_MAIL.test(String(r['Status'] || '').trim())) continue;   // compliance stop-list\n  if (clean(r['MailerLite Synced'])) continue;                       // never re-push\n  if (clean(r['Status']).toLowerCase() === 'unsubscribed') continue;\n  out.push({ json: {\n    _tab: tab, _row: r.row_number, dryRun: DRY_RUN, email,\n    first: clean(r['First Name']), last: clean(r['Last Name']), phone: clean(r['Phone']),\n  }});\n}\nreturn out;\n"
      },
      "id": "b4444444-4444-4444-8444-444444444444",
      "name": "Pick Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://connect.mailerlite.com/api/subscribers/{{ $json.email }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "batching": {
            "batch": {
              "batchSize": 25,
              "batchInterval": 30000
            }
          }
        }
      },
      "id": "b5555555-5555-4555-8555-555555555555",
      "name": "Check MailerLite",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "bgqmSCUYTRD7xhPi",
          "name": "MailerLite API"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://connect.mailerlite.com/api/subscribers",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $('Pick Candidates').item.json.email, fields: { name: $('Pick Candidates').item.json.first, last_name: $('Pick Candidates').item.json.last, phone: $('Pick Candidates').item.json.phone }, groups: ['193544692145587963'] }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "batching": {
            "batch": {
              "batchSize": 25,
              "batchInterval": 30000
            }
          }
        }
      },
      "id": "b7777777-7777-4777-8777-777777777777",
      "name": "Upsert To MailerLite",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "bgqmSCUYTRD7xhPi",
          "name": "MailerLite API"
        }
      },
      "disabled": false
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst cands  = $('Pick Candidates').all().map(i => i.json);\nconst checks = $('Check MailerLite').all().map(i => i.json);\nconst ups    = $('Upsert To MailerLite').all().map(i => i.json);\nconst today  = DateTime.now().setZone('America/Chicago').toFormat('yyyy-LL-dd');\nconst out = [];\nfor (let i = 0; i < cands.length; i++) {\n  const c = cands[i];\n  const code = (ups[i] || {}).statusCode;\n  // ONLY stamp a confirmed write. A 429/5xx must stay unstamped so the next run retries it.\n  if (code !== 200 && code !== 201) continue;\n  const present = (checks[i] || {}).statusCode === 200;\n  out.push({ json: {\n    _tab: c._tab,\n    row_number: c._row,\n    'MailerLite Synced': (present ? 'already on list ' : 'synced ') + today,\n  }});\n}\nreturn out;\n"
      },
      "id": "b9999999-9999-4999-8999-999999999999",
