    },
    {
      "id": "p5",
      "name": "Read Existing",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        800,
        0
      ],
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "1KWJ26qhQNrw6aescRA3fLYVY0vqUVnynxBdFccB7Rq4",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "LOY4ptTaJww2LC2j",
          "name": "Google Sheets account"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "p6",
      "name": "New Leads Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const GO_LIVE = '2026-08-04';\nconst rows = $('Read Existing').all().map(i => i.json);\nconst seen = new Set(rows.map(r => String(r['Meta Lead ID'] || '').trim()).filter(Boolean));\nconst forms = $('Forms').all().map(i => i.json);\nconst resps = $('Get Leads').all();\nconst cutoff = new Date(GO_LIVE + 'T00:00:00Z').getTime();\nconst pick = (f, words) => { for (const k of Object.keys(f)) { if (words.some(w => k.includes(w))) return f[k]; } return ''; };\nconst out = [];\nfor (let i = 0; i < resps.length; i++) {\n  const formName = (forms[i] || {}).formName || 'HM Buyer';\n  for (const lead of (resps[i].json.data || [])) {\n    const id = String(lead.id || '').trim();\n    if (!id || seen.has(id)) continue;\n    if (new Date(lead.created_time).getTime() < cutoff) continue;\n    const f = {};\n    for (const fd of (lead.field_data || [])) {\n      f[String(fd.name || '').toLowerCase()] = String((fd.values || [])[0] || '').trim();\n    }\n    const full = pick(f, ['full_name', 'name']);\n    const parts = full.split(/\\s+/).filter(Boolean);\n    out.push({ json: {\n      firstName: parts.shift() || '',\n      lastName: parts.join(' '),\n      email: pick(f, ['email']),\n      phone: pick(f, ['phone']),\n      leadgenId: id,\n      formName: formName,\n      utm_source: 'meta',\n      utm_campaign: 'hm-buyer',\n      utm_content: formName,\n      priceRange: pick(f, ['price', 'budget']),\n      timeline: pick(f, ['move', 'when', 'timeline', 'hoping']),\n      financing: pick(f, ['financ', 'approv', 'cash', 'lender']),\n      newsletterOptIn: false\n    } });\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "p7",
      "name": "Send To Hub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://n8n.meetpairwell.com/webhook/contact-sync-hm",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    }
  ],
