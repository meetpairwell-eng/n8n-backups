      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "url": "=https://graph.facebook.com/v21.0/{{ $json.formId }}/leads?fields=id,created_time,field_data&limit=100",
        "sendHeaders": true,
