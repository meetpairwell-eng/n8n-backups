    {
      "parameters": {
        "jsCode": "const sh = ($json.sheets||[]).find(s => s.properties && s.properties.title === 'Leads');\nconst gid = sh.properties.sheetId;\nconst rows = ((sh.data||[])[0]||{}).rowData || [];\nconst hits = [];\nrows.forEach(function(r,i){\n  const v = r.values||[];\n  const fn = (v[1] && v[1].formattedValue) || '';\n  if (i > 0 && String(fn).trim() === 'ZZPROBE') hits.push(i);\n});\nif (hits.length !== 1) throw new Error('expected exactly 1 ZZPROBE row, found ' + hits.length);\nreturn [{ json: { deleting: hits, payload: JSON.stringify({ requests: [ { deleteDimension: { range: { sheetId: gid, dimension: 'ROWS', startIndex: hits[0], endIndex: hits[0]+1 } } } ] }) } }];"
      },
