    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mailerlite-unsub-hm",
        "options": {}
      },
      "id": "30000000-0000-4000-8000-000000000000",
      "name": "MailerLite Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        -240,
        0
      ],
      "webhookId": "4a8f6c25-7e13-4d09-b562-0c9a3e7f1b84"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// MailerLite webhook payloads vary by event; dig the email out defensively.\nconst b = $input.first().json.body ?? $input.first().json;\nconst events = Array.isArray(b?.events) ? b.events : [b];\nconst out = [];\nfor (const ev of events) {\n  const d = ev?.data ?? {};\n  const email = String(\n    d?.subscriber?.email ?? d?.email ?? ev?.email ?? ''\n  ).trim().toLowerCase();\n  if (!email) continue;\n  const type = String(ev?.type ?? b?.type ?? 'unknown');\n  out.push({ json: { email, eventType: type } });\n}\nif (!out.length) throw new Error('No subscriber email found in MailerLite webhook payload');\nreturn out;\n"
      },
      "id": "31111111-1111-4111-8111-111111111111",
      "name": "Extract Email",
      "type": "n8n-nodes-base.code",
