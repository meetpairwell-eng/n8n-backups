    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst targets = new Map(\n  $('Extract Email').all().map(i => [i.json.email, i.json.eventType])\n);\nconst today = DateTime.now().setZone('America/Chicago').toFormat('yyyy-LL-dd');\n\nconst rows = [\n  ...$('Read Master').all().map(i => ({ tab: 'Updated', r: i.json })),\n  ...$('Read Leads').all().map(i => ({ tab: 'Leads',   r: i.json })),\n];\n\nconst out = [];\nfor (const { tab, r } of rows) {\n  const email = String(r['Email'] ?? '').trim().toLowerCase();\n  if (!email || !targets.has(email)) continue;\n  const ev = targets.get(email);\n  const reason = ev.includes('bounce') ? 'Bounced'\n               : ev.includes('spam')   ? 'Spam complaint'\n               : 'Unsubscribed';\n  out.push({ json: {\n    _tab: tab,\n    row_number: r.row_number,\n    'Status': reason,\n    'On Mailer List': '',                      // drop the gate so nothing re-adds them\n    'MailerLite Synced': reason + ' ' + today,  // keep stamped so the sync skips them\n  }});\n}\nreturn out;\n"
      },
      "id": "34444444-4444-4444-8444-444444444444",
