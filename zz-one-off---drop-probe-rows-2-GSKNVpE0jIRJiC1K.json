    {
      "parameters": {
        "jsCode": "const sh = ($json.sheets||[]).find(s => s.properties && s.properties.title === 'Leads');\nconst gid = sh.properties.sheetId;\nconst rows = ((sh.data||[])[0]||{}).rowData || [];\nconst hits = [];\nrows.forEach(function(r,i){\n  const v = r.values||[];\n  const fn = (v[1] && v[1].formattedValue) || '';\n  if (i > 0 && String(fn).trim().indexOf('ZZPROBE') === 0) hits.push(i);\n});\nif (!hits.length) throw new Error('no ZZPROBE rows');\nif (hits.length > 4) throw new Error('refusing, found ' + hits.length);\nconst requests = hits.slice().sort(function(a,b){return b-a;}).map(function(i){\n  return { deleteDimension: { range: { sheetId: gid, dimension: 'ROWS', startIndex: i, endIndex: i+1 } } };\n});\nreturn [{ json: { count: hits.length, payload: JSON.stringify({requests: requests}) } }];"
      },
