      {
        "parameters": {
          "jsCode": "const b = $('Webhook').first().json.body;\nconst firstName = (b.name || '').split(' ')[0];\nconst hr = DateTime.now().setZone('America/Chicago').hour;\nconst isLate = hr >= 20 || hr < 8;\nconst callPhrase = isLate ? 'give you a call first thing tomorrow morning' : 'give you a call shortly';\nconst isVal = b.source === 'Valuation Request';\nconst subject = isVal ? 'Got your home value request' : 'Got your message';\nconst para1 = isVal\n  ? `Thank you for requesting a home value on <strong>${b.searchedAddress}</strong>. I'll personally look at what's actually selling in your neighborhood and ${callPhrase} to go over a few quick details, so I can get you a real number instead of an automated guess.`\n  : `Thank you for reaching out. I'll ${callPhrase} to learn a bit more about what you're looking for and how I can help.`;\n\nconst html = `<div style=\"margin:0;padding:0;background:#f0f0ec;\">\n<div style=\"max-width:600px;margin:0 auto;padding:32px 16px;font-family:Helvetica,Arial,sans-serif;\">\n<div style=\"background:#fcfbf8;border:1px solid #e6e8e4;border-radius:6px;overflow:hidden;\">\n<div style=\"padding:40px 44px 44px;\">\n<div style=\"text-align:center;padding-bottom:22px;\">\n<div style=\"font-family:Georgia,'Times New Roman',serif;color:#6f9080;font-size:27px;font-weight:700;letter-spacing:0.3px;\">Hector Meza</div>\n<div style=\"font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#8a8f8c;font-weight:600;line-height:1.5;padding-top:8px;\">Briggs Freeman Sotheby's<br>International Realty</div>\n</div>\n<div style=\"height:1px;background:#e6e8e4;margin:0 0 26px 0;font-size:0;line-height:0;\">&nbsp;</div>\n<p style=\"color:#34393b;font-size:16px;line-height:1.65;margin:0 0 20px 0;\">Dear ${firstName},</p>\n<p style=\"color:#34393b;font-size:16px;line-height:1.65;margin:0 0 18px 0;\">${para1}</p>\n<p style=\"color:#34393b;font-size:16px;line-height:1.65;margin:0 0 18px 0;\">If you have any questions in the meantime, feel free to call or text me directly at (214) 686-5641.</p>\n<p style=\"color:#34393b;font-size:16px;line-height:1.65;margin:0 0 18px 0;\">I look forward to speaking with you.</p>\n<div style=\"margin-top:30px;\">\n<p style=\"color:#34393b;font-size:15px;margin:0 0 10px 0;\">Warm regards,</p>\n<p style=\"font-family:Georgia,'Times New Roman',serif;color:#6f9080;font-weight:700;font-size:17px;margin:0 0 2px 0;\">Hector Meza</p>\n<p style=\"color:#8a8f8c;font-size:12px;letter-spacing:1px;text-transform:uppercase;margin:2px 0 0 0;\">Briggs Freeman Sotheby's International Realty</p>\n<p style=\"color:#8a8f8c;font-size:14px;margin:8px 0 0 0;\">(214) 686-5641<br>hmeza@briggsfreeman.com</p>\n</div>\n</div>\n</div>\n</div>\n</div>`;\n\nconst headers = [\n  'From: Hector Meza <h.mezarealty@gmail.com>',\n  'Reply-To: hmeza@briggsfreeman.com',\n  'To: ' + b.email,\n  'Subject: ' + subject,\n  'MIME-Version: 1.0',\n  'Content-Type: text/html; charset=\"UTF-8\"'\n].join('\\r\\n');\n\nconst mime = headers + '\\r\\n\\r\\n' + html;\nconst raw = Buffer.from(mime, 'utf8').toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\nreturn [{ json: { raw } }];\n"
        },
