      "parameters": {
        "sendTo": "={{ $node['Lookup Agent (Master Sheet)'].json.Agent_Email }}",
        "subject": "=New Lead - {{ $('Webhook').item.json.body.searchedAddress || $('Webhook').item.json.body.source || 'Hector Website' }}",
        "message": "=<h3>Hey {{ $('Lookup Agent (Master Sheet)').item.json['Agent_First_Name '] }}, you have a new lead! </h3>\n<p><strong>Form:</strong> {{ $('Webhook').item.json.body.source || 'Website' }}</p>\n<p><strong>Address they searched:</strong> {{ $('Webhook').item.json.body.searchedAddress || '(none - general contact)' }}</p>\n<p><strong>Lead source:</strong> {{ $('Webhook').item.json.body.utm_source ? ('Paid ad: ' + ($('Webhook').item.json.body.utm_content || 'unknown') + ' (campaign ' + ($('Webhook').item.json.body.utm_campaign || 'n/a') + ')') : ($('Webhook').item.json.body.referrer ? ('Referral: ' + $('Webhook').item.json.body.referrer) : 'Organic / Direct') }}</p>\n<ul>\n<li><strong>Client Name:</strong> {{ $('Webhook').item.json.body.name }}</li>\n<li><strong>Client Email:</strong> {{ $('Webhook').item.json.body.email }}</li>\n<li><strong>Client Phone:</strong> {{ $('Webhook').item.json.body.phone }}</li>\n</ul>\n<p><strong>Message:</strong><br>\n{{ $('Webhook').item.json.body.message || '(none)' }}</p>",
        "options": {
          "bccList": "meetpairwell@gmail.com"
        }
