      "parameters": {
        "jsCode": "const sheets = $json.sheets || [];\nconst leads = sheets.find(s => s.properties && s.properties.title === 'Leads');\nif (!leads) throw new Error('Leads tab not found');\nconst vals = ['Replied','Called - No Answer','Left Voicemail','Appointment Set','Won','Lost','Dead','Do Not Contact','Unsubscribed','Bounced','Spam Complaint'];\nconst payload = { requests: [ { setDataValidation: { range: { sheetId: leads.properties.sheetId, startRowIndex: 1, endRowIndex: 2000, startColumnIndex: 16, endColumnIndex: 17 }, rule: { condition: { type: 'ONE_OF_LIST', values: vals.map(v => ({ userEnteredValue: v })) }, showCustomUi: true, strict: false } } } ] };\nreturn [{ json: { gid: leads.properties.sheetId, payload: JSON.stringify(payload) } }];"
      },
