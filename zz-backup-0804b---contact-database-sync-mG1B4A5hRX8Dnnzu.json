    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\nconst clean = v => (v === undefined || v === null) ? '' : String(v).trim();\n\nconst email = clean(b.email).toLowerCase();\n\nlet first = clean(b.firstName), last = clean(b.lastName);\nif (!first) {\n  const parts = clean(b.name).split(/\\s+/).filter(Boolean);\n  first = parts.shift() || '';\n  last = parts.join(' ');\n}\n\nconst rawPhone = clean(b.phone);\nconst d = rawPhone.replace(/\\D/g, '').replace(/^1(?=\\d{10}$)/, '');\nconst phone = d.length === 10 ? '(' + d.slice(0,3) + ')' + d.slice(3,6) + '-' + d.slice(6) : rawPhone;\n\nconst formName = clean(b.source);\nconst searched = clean(b.searchedAddress);\nlet leadType = 'General';\nif (/valuation|sell/i.test(formName) || searched) leadType = 'Seller';\nif (/buyer|buy/i.test(formName) || /buyer/i.test(clean(b.formName))) leadType = 'Buyer';\n\nconst utmSource = clean(b.utm_source);\nconst metaLeadId = clean(b.leadgenId || b.leadId);\nlet origin;\nif (metaLeadId) origin = 'Meta Instant Form';\nelse if (utmSource) origin = 'Paid ad: ' + utmSource;\nelse if (clean(b.referrer)) origin = 'Referral: ' + clean(b.referrer);\nelse origin = 'Website (organic/direct)';\n\n\nlet sourceLabel;\nif (metaLeadId) {\n  const fn = formName.toLowerCase();\n  sourceLabel = 'Meta lead ad' + (fn.includes('variant a') ? ' (house listing)' : fn.includes('variant b') ? ' (headshot)' : (formName ? ' - ' + formName : ''));\n} else if (/valuation|sell/i.test(formName) || searched) {\n  sourceLabel = 'Home valuation' + (searched ? ' - ' + searched : '');\n} else if (utmSource) {\n  sourceLabel = 'Paid ad: ' + (clean(b.utm_content) || utmSource);\n} else if (clean(b.referrer)) {\n  sourceLabel = 'Referral: ' + clean(b.referrer);\n} else {\n  sourceLabel = 'Website contact';\n}\n\nreturn [{ json: {\n  timestamp: DateTime.now().setZone('America/Chicago').toFormat('yyyy-LL-dd HH:mm'),\n  first, last, email, phone, leadType, origin, sourceLabel,\n  campaign: clean(b.utm_campaign),\n  ad: clean(b.utm_content),\n  searchedAddress: searched,\n  message: clean(b.message),\n  metaLeadId,\n    priceRange: clean(b.priceRange),\n    timeline: clean(b.timeline),\n    financing: clean(b.financing),\n  onMailerList: (b.newsletterOptIn === true || clean(b.newsletterOptIn).toLowerCase() === 'true') ? 'Y' : '',\n  formName\n} }];\n"
      },
