    {
      "parameters": {
        "jsCode": "\nconst lead = $('Normalize Lead').first().json;\nconst rows = $input.all().map(i => i.json);\n\nconst norm = s => String(s || '').trim().toLowerCase();\nconst digits = s => String(s || '').replace(/\\D/g, '').replace(/^1(?=\\d{10}$)/, '');\nconst leadPhone = digits(lead.phone);\n\nlet match = null;\nfor (const r of rows) {\n  if (lead.email && norm(r['Email']) === norm(lead.email)) { match = r; break; }\n  if (!match && leadPhone.length === 10 && digits(r['Phone']) === leadPhone) { match = r; }\n}\n\nconst notes = match\n  ? ('Already in Database as ' + [match['First Name'], match['Last Name']].filter(Boolean).join(' ')\n     + ' (' + (match['Category'] || 'uncategorized') + ')').trim()\n  : '';\n\nreturn [{ json: { ...lead, alreadyInDatabase: match ? 'Y' : '', notes } }];\n"
      },
